# UPONLY Configuration Environment Variables

# App Environment
ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# LLM Provider API Keys & Model Defaults
# Claude 3.5 Sonnet / Claude 3 Opus (Recommended for Peak Reasoning & Multi-Agent Orchestration)
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Integrations Configuration
GITHUB_TOKEN=your_github_personal_access_token
CRM_API_URL=https://api.crm.example.com
CRM_API_KEY=your_crm_api_key
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=uponly.in@gmail.com
SMTP_PASSWORD=your_app_password
